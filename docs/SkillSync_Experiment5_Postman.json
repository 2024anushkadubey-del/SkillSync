              "pm.test(\"Returns clean JSON error without raw stack trace\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.include(\"Not Found\");",
              "    pm.expect(jsonData).to.not.have.property('stack');",
              "});"
            ]
          }
        }
      ],
