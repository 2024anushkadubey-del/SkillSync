    {
      "name": "TEST 1 — Register Success (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Registration returns token and sanitized user profile\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('token');",
              "    pm.expect(jsonData).to.have.property('user');",
              "    pm.expect(jsonData.user).to.not.have.property('password');",
              "    pm.expect(jsonData.user).to.not.have.property('internalModerationNotes');",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set('token', jsonData.token);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alex Taylor\",\n  \"email\": \"alex.taylor.{{$timestamp}}@university.edu\",\n  \"major\": \"Cybersecurity & Data Networks\",\n  \"password\": \"SecureStudentPass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Registers a unique new student user using dynamic variable {{$timestamp}}. Passwords are encrypted with bcryptjs. Response omits sensitive fields (201 Created)."
      },
      "response": []
    },
