{
  "info": {
    "_postman_id": "skillsync-experiment4-rbac-crud",
    "name": "SkillSync Experiment 4 - RBAC & CRUD APIs",
    "description": "Postman collection demonstrating REST CRUD operations with JWT authentication and Role-Based Access Control (RBAC) on local MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "skillId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login – Staff (Student)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set('token', jsonData.token);",
              "        console.log('Staff JWT Token saved to variable: {{token}}');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"staff@university.edu\",\n  \"password\": \"StaffPass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Authenticate as a standard student (Staff role). Returns a signed JWT token."
      },
      "response": []
    },
    {
      "name": "2. Create Skill (CREATE – 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.id) {",
              "        pm.collectionVariables.set('skillId', jsonData.id);",
              "        console.log('Skill ID saved to variable: {{skillId}}');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"teach\",\n  \"name\": \"Node.js Backend Architecture\",\n  \"level\": \"Advanced\",\n  \"category\": \"Development\",\n  \"description\": \"REST API design, middleware, and database integration.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/skills",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "skills"
          ]
        },
        "description": "CREATE operation: Adds a new skill to the authenticated student's profile in MongoDB."
      },
      "response": []
    },
    {
      "name": "3. Get All Skills (READ All – 200 OK)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/skills",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "skills"
          ]
        },
        "description": "READ operation: Retrieves the list of skills offered and wanted by the current user from MongoDB."
      },
      "response": []
    },
    {
      "name": "4. Get Single Skill (READ One – 200 OK)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/skills/{{skillId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "skills",
            "{{skillId}}"
          ]
        },
        "description": "READ operation: Fetches a single skill resource by its unique ID."
      },
      "response": []
    },
    {
      "name": "5. Update Skill (UPDATE – 200 OK)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"level\": \"Expert\",\n  \"description\": \"Updated: Production-grade REST API design with RBAC security.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/skills/{{skillId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "skills",
            "{{skillId}}"
          ]
        },
        "description": "UPDATE operation: Modifies the level and description of an existing skill in MongoDB."
      },
      "response": []
    },
    {
      "name": "6. Login – Auditor (Read-Only Role)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set('token', jsonData.token);",
              "        console.log('Auditor JWT Token saved to variable: {{token}}');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"auditor@university.edu\",\n  \"password\": \"AuditorPass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Authenticate as a Compliance Auditor (Role: auditor). Has read-only permissions across all collections."
      },
      "response": []
    },
    {
      "name": "7. Auditor GET Skills (READ Allowed – 200 OK)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/skills",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "skills"
          ]
        },
        "description": "Demonstrates Auditor READ privilege: Auditor can inspect skills catalogs (200 OK)."
      },
      "response": []
    },
    {
      "name": "8. Auditor Create Skill (RBAC Blocked – 403 Forbidden)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"teach\",\n  \"name\": \"Unauthorized Skill Addition\",\n  \"level\": \"Beginner\",\n  \"category\": \"General\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/skills",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "skills"
          ]
        },
        "description": "Demonstrates RBAC enforcement: Auditor attempt to CREATE a skill is rejected with 403 Forbidden by the server."
      },
      "response": []
    },
    {
      "name": "9. Delete Skill (DELETE – 200 OK)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/skills/{{skillId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "skills",
            "{{skillId}}"
          ]
        },
        "description": "DELETE operation: Removes the skill resource from MongoDB (use Staff/Admin token)."
      },
      "response": []
    }
  ]
}
