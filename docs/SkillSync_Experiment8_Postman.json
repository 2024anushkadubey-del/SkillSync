{
  "info": {
    "_postman_id": "skillsync-exp8-socketio-collection",
    "name": "SkillSync - Experiment 8 (Socket.IO & Real-Time Announcements)",
    "description": "Postman API collection for testing Experiment 8: Real-Time Communication via Socket.IO, authenticated admin announcement publication, RBAC rejection, input validation, and announcements retrieval.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check (Verifies Socket.IO Active)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "response": []
    },
    {
      "name": "2. Login as Admin (Obtain Admin JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set(\"adminToken\", jsonData.token);",
              "    pm.globals.set(\"adminToken\", jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@university.edu\",\n  \"password\": \"AdminPass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "3. Login as Regular User (Obtain Staff JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set(\"userToken\", jsonData.token);",
              "    pm.globals.set(\"userToken\", jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"staff@university.edu\",\n  \"password\": \"StaffPass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "4. Publish Announcement - Admin Success (HTTP 201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"registration for syrus extended\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/announcements",
          "host": ["{{baseUrl}}"],
          "path": ["api", "announcements"]
        }
      },
      "response": []
    },
    {
      "name": "5. Publish Announcement - Non-Admin RBAC Rejection (HTTP 403 Forbidden)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Unauthorized announcement attempt\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/announcements",
          "host": ["{{baseUrl}}"],
          "path": ["api", "announcements"]
        }
      },
      "response": []
    },
    {
      "name": "6. Publish Announcement - Unauthenticated Rejection (HTTP 401 Unauthorized)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Unauthenticated announcement attempt\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/announcements",
          "host": ["{{baseUrl}}"],
          "path": ["api", "announcements"]
        }
      },
      "response": []
    },
    {
      "name": "7. Publish Announcement - Empty Message Rejection (HTTP 400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"   \"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/announcements",
          "host": ["{{baseUrl}}"],
          "path": ["api", "announcements"]
        }
      },
      "response": []
    },
    {
      "name": "8. Get Live Announcements (HTTP 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/announcements",
          "host": ["{{baseUrl}}"],
          "path": ["api", "announcements"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    }
  ]
}
